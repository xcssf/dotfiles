# === ENVIRONMENT VARIABLES ===
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza"
typeset -U path PATH
path+=("$HOME/.local/bin")
path+=("$HOME/.bun/bin")

# === MACHINE-LOCAL ===
{{ if eq .chezmoi.os "linux" -}}
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
{{ end}}


# === HISTORY ===
HISTFILE=~/.histfile
SAVEHIST=9000
HISTSIZE=9999
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_NO_STORE
setopt HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt autocd extendedglob
bindkey -e


# === ZINIT ===
{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  if ! command -v git >/dev/null 2>&1; then
    print -u2 "zsh: git is required to bootstrap Zinit ($ZINIT_HOME)"
  elif ! mkdir -p "${ZINIT_HOME:h}" || ! git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"; then
    print -u2 "zsh: failed to install Zinit at $ZINIT_HOME"
  fi
fi

if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"

