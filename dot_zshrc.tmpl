# === ENVIRONMENT VARIABLES ===
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza"
typeset -U path PATH
path+=("$HOME/.local/bin") # Clean PATH when sourcing .zshrc again


# === MACHINE-LOCAL ===
{{ if eq .chezmoi.os "linux" -}}
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
{{ end}}


# === HISTORY ===
HISTFILE=~/.histfile
SAVEHIST=9000
HISTSIZE=9999
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_NO_STORE
setopt HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt autocd extendedglob
bindkey -e


# === ZINIT / OH MY ZSH ===
{{ if eq .chezmoi.os "darwin" -}}
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  if ! command -v git >/dev/null 2>&1; then
    print -u2 "zsh: git is required to bootstrap Zinit ($ZINIT_HOME)"
  elif ! mkdir -p "${ZINIT_HOME:h}" || ! git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"; then
    print -u2 "zsh: failed to install Zinit at $ZINIT_HOME"
  fi
fi

if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"

  zinit ice as"command" from"gh-r" bpick"atuin-*.tar.gz" \
    mv"atuin*/atuin -> atuin" \
    atclone"./atuin init zsh > init.zsh; ./atuin gen-completions --shell zsh > _atuin" \
    atpull"%atclone"
  zinit light atuinsh/atuin

  zinit ice as"command" atclone"./install --bin" atpull"%atclone" pick"bin/fzf"
  zinit light junegunn/fzf

  zinit ice as"command" from"gh-r" \
  bpick"starship-*-apple-darwin.tar.gz" pick"starship" nocompile
  zinit light starship/starship

  zinit light zsh-users/zsh-autosuggestions
  zinit ice as"command" from"gh-r" bpick"*apple-darwin.tar.gz" pick"zoxide" nocompile
  zinit light ajeetdsouza/zoxide

else
  print -u2 "zsh: Zinit unavailable; plugin-managed Atuin, zoxide, and fzf are disabled"
fi

{{- else if eq .chezmoi.os "linux" -}}
export ZSH="$HOME/.oh-my-zsh"
HYPHEN_INSENSITIVE="true"
COMPLETION_WAITING_DOTS="true"
plugins=(git)
source $ZSH/oh-my-zsh.sh
{{ end }}


# AUTOCOMPLETE
autoload -Uz compinit
compinit
{{ if eq .chezmoi.os "darwin" -}}
if (( $+functions[zinit] )); then
  zinit cdreplay -q
fi
{{- end }}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' max-errors 5

{{ if eq .chezmoi.os "darwin" -}}
# Source generated Atuin init after compinit so widgets and completions register.
if (( $+functions[zinit] )); then
  ATUIN_INIT="${ZINIT[PLUGINS_DIR]}/atuinsh---atuin/init.zsh"
  [[ -r "$ATUIN_INIT" ]] && source "$ATUIN_INIT"
fi

# Keep Atuin's Ctrl-R widget; fzf still supplies its other ZLE widgets.
if command -v fzf >/dev/null 2>&1; then
  FZF_CTRL_R_COMMAND= source <(fzf --zsh)
fi
{{- end }}


# AUTOSUGGESTIONS
{{ if eq .chezmoi.os "linux" -}}
[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
{{- end }}


# SYNTAX HIGHLIGHTING
{{ if eq .chezmoi.os "linux" -}}
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- end }}


# === FZF ===
{{ if eq .chezmoi.os "linux" -}}
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)
{{- end }}


# === ZOXIDE ===
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"


# === PYTHON ===
# Python environment switching (pyenv)
{{ if eq .chezmoi.os "darwin" -}}
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
  if command -v pyenv-virtualenv-init >/dev/null 2>&1; then
    eval "$(pyenv virtualenv-init -)"
  fi
fi
{{- end }}

# === STARSHIP ===
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi


# === ALIASES ===
if command -v eza >/dev/null 2>&1; then
  alias l='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
fi
alias grep='grep --color=auto'
command -v trash >/dev/null 2>&1 && alias rm='trash'


# === ZSH-SYNTAX-HIGHLIGHTING ===
{{ if eq .chezmoi.os "darwin" -}}
# Load syntax highlighting last, after other ZLE integrations.
if (( $+functions[zinit] )); then
  zinit light zdharma-continuum/fast-syntax-highlighting
fi
{{- end }}
