# === ENVIRONMENT VARIABLES ===
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
export PATH="$PATH:$HOME/.local/bin"


# === MACHINE-LOCAL ===
{{ if eq .chezmoi.os "linux" -}}
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
{{ end}}


# === HISTORY ===
HISTFILE=~/.histfile
SAVEHIST=9000
HISTSIZE=9999
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_NO_STORE
setopt HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt autocd extendedglob
bindkey -e


# === ZINIT / OH MY ZSH ===
{{ if eq .chezmoi.os "darwin" -}}
source "${HOME}/.zinit/bin/zinit.zsh"
zinit self-update
zinit update --all

zinit ice as"command" from"gh-r" bpick"atuin-*.tar.gz" mv"atuin*/atuin -> atuin" atclone"./atuin init zsh > init.zsh; ./atuin gen-completions --shell zsh > _atuin" atpull"%atclone" src"init.zsh"
zinit light atuinsh/atuin

zinit light zsh-users/zsh-autosuggestions
zinit light zdharma-continuum/fast-syntax-highlighting

zinit ice wait lucid atinit"source shell/key-bindings.zsh; source shell/completion.zsh"
zinit light junegunn/fzf

{{- else if eq .chezmoi.os "linux" -}}
export ZSH="$HOME/.oh-my-zsh"
HYPHEN_INSENSITIVE="true"
COMPLETION_WAITING_DOTS="true"
plugins=(git)
source $ZSH/oh-my-zsh.sh
{{ end }}


# AUTOCOMPLETE
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' max-errors 5


# AUTOSUGGESTIONS
{{ if eq .chezmoi.os "linux" -}}
[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
{{- end }}


# SYNTAX HIGHLIGHTING
{{ if eq .chezmoi.os "linux" -}}
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- end }}


# === FZF ===
{{ if eq .chezmoi.os "linux" -}}
command -v fzf >/dev/null && source <(fzf --zsh)
{{- end }}


# === ZOXIDE ===
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"


# === PYTHON ===
# Python environment switching (pyenv)
{{ if eq .chezmoi.os "darwin" -}}
eval "$(pyenv init -)"
if which pyenv-virtualenv-init > /dev/null; then eval "$(pyenv virtualenv-init -)"; fi
{{- end }}


# ALIASES (after oh-my-zsh, which defines its own l/ll)
alias l='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
alias ll='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
alias lll='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
alias grep='grep --color=auto'
command -v trash >/dev/null && alias rm='trash'


# PROMPT
command -v oh-my-posh >/dev/null && eval "$(oh-my-posh init zsh --config catppuccin_latte --strict)"
