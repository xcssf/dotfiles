# AUTOCOMPLETE
autoload -Uz compinit
compinit
{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
if (( $+functions[zinit] )); then
  zinit cdreplay -q
fi
{{- end }}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' max-errors 5

{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
# Source generated Atuin init after compinit so widgets and completions register.
if (( $+functions[zinit] )); then
  ATUIN_INIT="${ZINIT[PLUGINS_DIR]}/atuinsh---atuin/init.zsh"
  [[ -r "$ATUIN_INIT" ]] && source "$ATUIN_INIT"
fi

# Keep Atuin's Ctrl-R widget; fzf still supplies its other ZLE widgets.
if command -v fzf >/dev/null 2>&1; then
  FZF_CTRL_R_COMMAND= source <(fzf --zsh)
fi
{{- end }}


# === ZOXIDE ===
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"


# === PYTHON ===
# Python environment switching (pyenv)
{{ if eq .chezmoi.os "darwin" -}}
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
  if command -v pyenv-virtualenv-init >/dev/null 2>&1; then
    eval "$(pyenv virtualenv-init -)"
  fi
fi
{{- end }}

# === STARSHIP ===
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi


# === ALIASES ===
if command -v eza >/dev/null 2>&1; then
  alias l='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
fi
alias grep='grep --color=auto'
command -v trash >/dev/null 2>&1 && alias rm='trash'


# === KEY BINDINGS ===
# Apply after plugin integrations. Emacs mode does not bind these terminal
# sequences by default; an unbound sequence can insert its trailing '~'.
zmodload zsh/terminfo
# Standard xterm/Windows Terminal sequences, including legacy Ctrl+Delete.
bindkey -M emacs '^[[3~' delete-char
bindkey -M emacs '^[[3;5~' kill-word
bindkey -M emacs '^[[3^' kill-word
# Prefer terminal-specific sequences when terminfo provides them.
[[ -n ${terminfo[kdch1]} ]] && bindkey -M emacs "${terminfo[kdch1]}" delete-char
[[ -n ${terminfo[kDC5]} ]] && bindkey -M emacs "${terminfo[kDC5]}" kill-word


# === ZSH-SYNTAX-HIGHLIGHTING ===
{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
# Load syntax highlighting last, after other ZLE integrations.
if (( $+functions[zinit] )); then
  zinit light zdharma-continuum/fast-syntax-highlighting
fi
{{- end }}
