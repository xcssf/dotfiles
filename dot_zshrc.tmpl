# ENVIRONMENT VARIABLES
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
export PATH="$PATH:$HOME/.local/bin"

# MACHINE-LOCAL
{{ if eq .chezmoi.os "linux" -}}
[[ -r ~/.zshrc.local ]]
source ~/.zshrc.local
{{ end}}

# HISTORY
{{ if eq .chezmoi.os "linux" -}}
HISTFILE=~/.histfile
SAVEHIST=9000
HISTSIZE=9999
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_NO_STORE
setopt HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt autocd extendedglob
bindkey -e
{{ end }}

# OH MY ZSH (runs compinit itself)
{{ if eq .chezmoi.os "linux" -}}
export ZSH="$HOME/.oh-my-zsh"
HYPHEN_INSENSITIVE="true"
COMPLETION_WAITING_DOTS="true"
plugins=(git)
source $ZSH/oh-my-zsh.sh

{{ else }}

# AUTOCOMPLETE
autoload -Uz compinit
compinit
{{ end }}


# AUTOCOMPLETE
# Case-insensitive matching autocomplete
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'


# PYTHON
# Python environment switching (pyenv)
{{ if eq .chezmoi.os "darwin" -}}
eval "$(pyenv init -)"
if which pyenv-virtualenv-init > /dev/null; then eval "$(pyenv virtualenv-init -)"; fi
{{- end }}


# AUTOSUGGESTIONS
{{ if eq .chezmoi.os "darwin" -}}
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#808080"

{{- else if eq .chezmoi.os "linux" -}}

[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
{{- end }}


# SYNTAX HIGHLIGHTING
{{ if eq .chezmoi.os "darwin" -}}
source ~/Tools/Terminal/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
{{- else if eq .chezmoi.os "linux" -}}
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- end }}


# fzf
command -v fzf >/dev/null && source <(fzf --zsh)


# zoxide
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"


# ALIASES (after oh-my-zsh, which defines its own l/ll)
alias l='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
alias ll='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
alias lll='eza --color=always --color-scale=all --color-scale-mode=gradient --icons=always --group-directories-first -a -l --git -h'
alias grep='grep --color=auto'
command -v trash >/dev/null && alias rm='trash'


# PROMPT
command -v oh-my-posh >/dev/null && eval "$(oh-my-posh init zsh --config catppuccin_latte --strict)"
