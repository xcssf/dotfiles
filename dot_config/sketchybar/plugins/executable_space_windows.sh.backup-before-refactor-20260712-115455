  #echo "Space : ${space}"
  #echo "Apps : ${apps[@]}"
  #echo "Length : ${#apps[@]}"

  # Get current app items on the current space
  items=()
  while IFS= read -r line; do
    items+=("$line")
  done < <(sketchybar --query bar | jq -r ".items[]? | select(startswith(\"${space}.app.\") and test(\"[0-9]+$\"))")
  #echo "${items[@]}"
  #echo "Length : ${#items[@]}"
  #echo "--------"

  # Remove stale indexed app items deterministically.
  # Do not rely on the order returned by `sketchybar --query bar`.
  for item in "${items[@]}"; do
    index="${item##*.}"
    if [[ "$index" =~ ^[0-9]+$ ]] && (( index >= ${#apps[@]} )); then
      #echo "Deleting stale item ${item}"
      sketchybar --remove "$item"
    fi
  done
  #echo "All items deleted"
  

  # While there are more apps than items, create new items
  if [[ ${#apps[@]} -ne 0 ]]; then    # If there are apps to draw
    #items=()
    i=0
    while [[ i -lt ${#apps[@]} ]]; do
      app=${apps[$i]}
      item="${space}.app.${i}"

      if ! item_exists "$item"; then
        #echo "${item} does not exist. Adding one for ${app}"
        sketchybar --add item "$item" left        # Create the item
        sketchybar --move "$item" after "$space"  # Move the item after the corresponding "space" item
        #items+=$item
      else
        echo "${item} exists"
      fi
      
      sketchybar --set "$item" \
        icon.background.drawing=on \
        icon.background.image="app.${app}"
      ((i++))
    done
  fi
  

































