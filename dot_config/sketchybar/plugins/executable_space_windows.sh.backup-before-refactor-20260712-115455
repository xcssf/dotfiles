#!/bin/bash

get_current_space() {
  echo "space.$(echo "$INFO" | jq -r '.space')"
}

item_exists() {
    #echo "Checking existence of $1"
    sketchybar --query "$1" >/dev/null 2>&1
}

if [ "$SENDER" = "space_windows_change" ]; then
  # Get current space
  #echo $INFO
  space=$(get_current_space)
  
  # Debug : doing it only on space 1
  #if [[ $space != "space.3" ]]; then
  #  exit
  #fi

  # Get current apps on the current space
  apps=()
  while IFS= read -r app; do
    apps+=("$app")
  done < <(echo "$INFO" | jq -r '.apps | keys[]?')
