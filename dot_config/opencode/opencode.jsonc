{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow"
    }
  },
  "plugins": [
    "oh-my-opencode-slim@3.0.4",
    "@slkiser/opencode-quota@5.0.2"
  ],
  "provider": {
    "moonshotai": {
      "models": {
        "kimi-k2.6": {
          "options": {
            "temperature": 1
          }
        }
      }
    },
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {}
  }
}
